# OpenCTEM web console: local development settings. Copy to .env.local.
# Every variable is optional; unset ones keep the default shown. Production
# installs set these in the deployment (api/deploy/docker-compose.yml, the Helm
# chart), not from this file.

# Internal URL of the API. The console proxies the browser's /api/v1 calls and
# the WebSocket upgrade to it, so browsers never reach the API port.
BACKEND_API_URL=http://localhost:8080

# The platform console is its own app (console/, `npm run dev:console`, port
# 3001). ADMIN_API_URL is the API's console listener it proxies to; unset, it
# uses BACKEND_API_URL. The tenant app never reads it.
# ADMIN_API_URL=http://localhost:8081

# Public origin of the console (the platform's APP_URL). Used for the
# Content-Security-Policy and post-login redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secure flag on the console's cookies. Only false turns it off: local http.
SECURE_COOKIES=false

# Forward X-Real-IP / X-Forwarded-For to the API (organization IP allowlists).
# true ONLY behind a reverse proxy that OVERWRITES those headers; otherwise a
# caller could choose its own IP. Default false.
# TRUST_PROXY_HEADERS=false

# Lifetime in seconds of the session cookies. Default 604800 (7 days).
# COOKIE_MAX_AGE=604800

# Empty: the WebSocket opens on the console's own origin and is proxied to
# BACKEND_API_URL. Set only for a same-site WebSocket host.
# NEXT_PUBLIC_WS_BASE_URL=

# Error reporting (empty: off).
# NEXT_PUBLIC_SENTRY_DSN=

# Show live count badges in the sidebar (more API calls on page load).
# NEXT_PUBLIC_ENABLE_SIDEBAR_BADGES=false

# Product name and description in the page title and meta tags (read when the
# console is built, not at run time).
# NEXT_PUBLIC_APP_DESCRIPTION=

# Legal documents, read at request time. The sign-in and register pages link
# the terms and privacy policy; with none, no notice shows.
# LEGAL_TERMS_URL=
# LEGAL_PRIVACY_URL=
# Or the built-in templates (/terms, /acceptable-use, /privacy, /dpa,
# /subprocessors); review them with counsel. Unset values show as marked
# placeholders.
# LEGAL_PAGES_ENABLED=false
# LEGAL_ORGANIZATION_NAME=
# LEGAL_SERVICE_NAME=
# LEGAL_CONTACT_EMAIL=
# LEGAL_WEBSITE_URL=
# LEGAL_DOCS_URL=
# LEGAL_ADDRESS=
# LEGAL_JURISDICTION=
# LEGAL_EFFECTIVE_DATE=

# /.well-known/security.txt (RFC 9116): served with security@openctem.io and
# the OpenCTEM disclosure policy as Policy. SECURITY_CONTACT (an e-mail address
# or https URL) replaces the contact and drops the default Policy;
# SECURITY_POLICY_URL (https) sets Policy; SECURITY_TXT_ENABLED=false turns it off.
# SECURITY_CONTACT=
# SECURITY_POLICY_URL=
# SECURITY_TXT_ENABLED=true
