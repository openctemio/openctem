# =============================================================================
# Dockerfile for Database Seeding
# =============================================================================
# Lightweight image containing seed SQL files for initializing database data.
# Used by docker-compose to seed the database with required or test data.
#
# Build:
#   docker build -f Dockerfile.seed -t ghcr.io/openctemio/seed:v0.1.0 .
#
# Usage:
#   # Seed required data
#   docker run --rm -e PGHOST=postgres -e PGUSER=openctem -e PGPASSWORD=secret -e PGDATABASE=openctem \
#     ghcr.io/openctemio/seed:v0.1.0 psql -f /seed/seed_required.sql
#
#   # Seed test data
#   docker run --rm -e PGHOST=postgres -e PGUSER=openctem -e PGPASSWORD=secret -e PGDATABASE=openctem \
#     ghcr.io/openctemio/seed:v0.1.0 psql -f /seed/seed_test.sql
#
# Seed Files:
#   - seed_required.sql      - Required data (roles, permissions, default settings)
#   - seed_test.sql          - Test/demo data (test users, sample assets)
#
# The image is a psql client and the seed files: the seeds run against the
# server given by the PG* variables, so no database server is in the image,
# and psql needs no privileges (uid of the distroless "nonroot" user, as in
# the migrations image).
#
# checkov:skip=CKV_DOCKER_2: One-time seed container, no healthcheck needed
# =============================================================================

FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

RUN apk add --no-cache postgresql18-client

# Copy seed files
COPY migrations/seed /seed

LABEL org.opencontainers.image.title="OpenCTEM seed" \
      org.opencontainers.image.description="OpenCTEM seed SQL files and a psql client" \
      org.opencontainers.image.source="https://github.com/openctemio/openctem" \
      org.opencontainers.image.licenses="GPL-3.0-only"

USER 65532:65532

# Default: show available seed files
CMD ["sh", "-c", "echo 'Available seed files:' && ls -la /seed/*.sql"]
