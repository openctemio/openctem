{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openctem.io/schemas/filter-document/v1.json",
  "title": "FilterDocument",
  "description": "RFC-048 FilterDocument: the body of POST /{resource}/search and the stored form of saved views, exports, reports and campaigns. Field names and enums are per resource (GET /api/v1/meta/filters/{resource}). Limits: 50 leaves, depth 3, 100 values per list (500 for id fields), 200 characters per value, q 255, 32 KB per document.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "filter": {
      "oneOf": [
        { "$ref": "#/$defs/node" },
        { "$ref": "#/$defs/shorthand" }
      ]
    },
    "q": { "type": "string", "maxLength": 255 },
    "sort": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "pattern": "^[-+]?[a-z][a-z0-9_]*$" }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "per_page": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cursor": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "scalar": {
      "oneOf": [
        { "type": "string", "maxLength": 200 },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "op", "value"],
      "properties": {
        "field": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "op": {
          "enum": ["eq", "ne", "in", "not_in", "gte", "gt", "lte", "lt", "is_null", "contains"]
        },
        "value": {
          "oneOf": [
            { "$ref": "#/$defs/scalar" },
            { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/scalar" } }
          ]
        }
      }
    },
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/leaf" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/node" } }
        }
      ]
    },
    "shorthand": {
      "description": "Flat param names (as in the GET query) mapped to a value or list: all of them must match.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$", "not": { "enum": ["all", "any", "not", "field"] } },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/scalar" },
          { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/scalar" } }
        ]
      }
    }
  }
}
