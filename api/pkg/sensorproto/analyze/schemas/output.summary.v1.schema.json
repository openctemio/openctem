{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openctem.io/schemas/analyze/output/summary/v1.json",
  "title": "openctem.ai.summary/v1",
  "description": "Output of kind summary.v1: one plain-text summary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["suggestions"],
  "properties": {
    "suggestions": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "https://openctem.io/schemas/analyze/suggestion/v1.json#/$defs/summary"}
        ]
      }
    }
  }
}
