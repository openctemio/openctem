{{- $slug := slugify .Sensor.Name -}}
# {{product}} Tenable.sc connector "{{$slug}}": Docker Compose
# Generated by {{product}} at {{.GeneratedAt}}. Edit
# configs/sensor-products/connector-tenable/compose.tmpl on the API host to
# change it.
#
# The connector connects out to the platform and to your Tenable.sc (no
# inbound port) and runs no scanner. In an empty directory on a host that
# reaches your Tenable.sc:
#   1. Put the sensor's API key in .env (kept out of this file):
{{- if .APIKey}}
#        printf '%s\n' 'OPENCTEM_API_KEY={{.APIKey}}' > .env && chmod 600 .env
{{- else}}
#        printf '%s\n' 'OPENCTEM_API_KEY=octs_...' > .env && chmod 600 .env
#      (the key is shown once, when the sensor is created or its key rotated)
{{- end}}
#   2. Write the connector config, /etc/openctem/connectors/tenable-sc.yaml
#      (root-owned, mode 0640), and the key files of a least-privilege
#      Tenable.sc user in /run/secrets/tenable-sc (see the connector's README).
#   3. Save this file as compose.yaml and run: docker compose up -d
{{- if .CACert}}
#   The platform's private CA is embedded below (configs.content needs
#   Docker Compose 2.23.1 or later).
{{- end}}
services:
  connector:
    image: {{.Image}}
    container_name: {{$slug}}
    restart: unless-stopped
    # Hardened: read-only root filesystem, no capabilities, no privilege
    # escalation.
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    environment:
      SENSOR_API_URL: {{yamlQuote .BaseURL}}
      SENSOR_API_KEY: ${OPENCTEM_API_KEY:?set OPENCTEM_API_KEY in .env}
{{- if .CACert}}
      SENSOR_CA_CERT_FILE: /etc/openctem/certs/openctem-root-ca.crt
{{- end}}
    volumes:
      - data:/var/lib/openctem
      - /etc/openctem/connectors:/etc/openctem/connectors:ro
      - /run/secrets/tenable-sc:/run/secrets/tenable-sc:ro
{{- if .CACert}}
    configs:
      - source: openctem_ca
        target: /etc/openctem/certs/openctem-root-ca.crt
        mode: 0444
{{- end}}

volumes:
  # The connector's data: the sensor identity, the API key it renews on its
  # own and the outbox of undelivered results. Keep it with the container.
  data:
{{- if .CACert}}

configs:
  openctem_ca:
    content: |
{{indent 6 .CACert}}
{{- end}}
