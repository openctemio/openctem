{{- $slug := slugify .Sensor.Name -}}
# {{product}} Tenable.sc connector "{{$slug}}": docker run
# Generated by {{product}} at {{.GeneratedAt}}. Run it on a host that reaches
# your Tenable.sc. Edit configs/sensor-products/connector-tenable/docker.tmpl
# on the API host to change it.
{{- if not .APIKey}}
#
# The command reads the sensor's API key from OPENCTEM_API_KEY. The key is
# shown once, when the sensor is created or its key is rotated:
#   export OPENCTEM_API_KEY='octs_...'
{{- end}}
#
# Before you start it, write the connector config and the key files of a
# least-privilege Tenable.sc user (see the connector's README):
#   /etc/openctem/connectors/tenable-sc.yaml   root-owned, mode 0640
#   /run/secrets/tenable-sc/                   the access and secret key files
{{- if .CACert}}

# 1. Trust the platform's certificate authority (it uses a private CA).
sudo mkdir -p /etc/openctem/certs
sudo tee /etc/openctem/certs/openctem-root-ca.crt >/dev/null <<'OPENCTEM_CA'
{{.CACert}}OPENCTEM_CA
sudo chmod 0644 /etc/openctem/certs/openctem-root-ca.crt
{{- end}}
{{- if .ReleaseIdentity}}

# {{if .CACert}}2{{else}}1{{end}}. Check the image signature (keyless, cosign v3).
cosign verify {{.Image}} \
  --certificate-oidc-issuer https://token.actions.githubusercontent.com \
  --certificate-identity {{shellQuote (printf "%s@refs/tags/%s" .ReleaseIdentity .ImageTag)}}
{{- end}}

# Start the connector. It connects out to the platform and to your
# Tenable.sc (no inbound port) and runs no scanner. Hardened: read-only root
# filesystem, no capabilities, no privilege escalation. The volume
# {{$slug}}-data at /var/lib/openctem holds the sensor identity, the API key it
# renews on its own and the outbox of undelivered results: keep it with the
# container.
docker run -d --name {{$slug}} --restart unless-stopped \
  --read-only --cap-drop ALL --security-opt no-new-privileges:true \
  -e SENSOR_API_URL={{shellQuote .BaseURL}} \
{{- if .APIKey}}
  -e SENSOR_API_KEY={{shellQuote .APIKey}} \
{{- else}}
  -e SENSOR_API_KEY="${OPENCTEM_API_KEY:?export OPENCTEM_API_KEY first}" \
{{- end}}
{{- if .CACert}}
  -e SENSOR_CA_CERT_FILE=/etc/openctem/certs/openctem-root-ca.crt \
  -v /etc/openctem/certs:/etc/openctem/certs:ro \
{{- end}}
  -v {{$slug}}-data:/var/lib/openctem \
  -v /etc/openctem/connectors:/etc/openctem/connectors:ro \
  -v /run/secrets/tenable-sc:/run/secrets/tenable-sc:ro \
  {{.Image}}

# Check it: docker logs -f {{$slug}}   (the Sensors page shows it online
# within a minute). Then give it the grant it needs (job types
# connector_sync, and connector_scan if you allow scans; tool tenable_sc) and
# pick it under Settings > Integrations > Tenable.sc.
