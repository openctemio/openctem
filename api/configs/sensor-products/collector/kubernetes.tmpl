{{- $slug := slugify .Sensor.Name -}}
# {{product}} collector "{{$slug}}": Kubernetes manifests
# Generated by {{product}} at {{.GeneratedAt}}. Edit
# configs/sensor-products/collector/kubernetes.tmpl on the API host to change it.
#
# The asset collector reads inventory from your systems and sends it to the
# platform. It takes no scan jobs and runs no scanner. Replace the example
# vendor (Active Directory) with yours, then:
#   kubectl apply -n <namespace> -f {{$slug}}.yaml
{{- if not .APIKey}}
# Replace octs_... below with the sensor's API key first (it is shown once,
# when the sensor is created or its key is rotated).
{{- end}}
apiVersion: v1
kind: Secret
metadata:
  name: {{$slug}}
  labels:
    app.kubernetes.io/name: openctem-asset-collector
    app.kubernetes.io/instance: {{$slug}}
type: Opaque
stringData:
  api-key: {{if .APIKey}}{{.APIKey}}{{else}}octs_...{{end}}
  ldap-password: "<the bind password>"
{{- if .CACert}}
  ca.crt: |
{{indent 4 .CACert}}
{{- end}}
---
# The collector's data: state/ (its identity) and outbox/ (results not yet
# delivered). Keep it; back it up like a credential.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{$slug}}-data
  labels:
    app.kubernetes.io/name: openctem-asset-collector
    app.kubernetes.io/instance: {{$slug}}
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: 1Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{$slug}}
  labels:
    app.kubernetes.io/name: openctem-asset-collector
    app.kubernetes.io/instance: {{$slug}}
spec:
  # One identity and one outbox: a single replica, the old pod stops first.
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{$slug}}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: openctem-asset-collector
        app.kubernetes.io/instance: {{$slug}}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        fsGroupChangePolicy: OnRootMismatch
        # It starts no tool processes: the runtime's default profile fits.
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: collector
          image: {{.Image}}
          args: ["-daemon"]
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          env:
            - name: SENSOR_API_URL
              value: {{yamlQuote .BaseURL}}
            - name: SENSOR_API_KEY_FILE
              value: /run/secrets/openctem/api-key
            - name: LDAP_URL
              value: ldaps://dc1.example.local:636
            - name: LDAP_BIND_DN
              value: svc-openctem@example.local
            - name: LDAP_PASSWORD_FILE
              value: /run/secrets/openctem/ldap-password
            - name: LDAP_BASE_DN
              value: DC=example,DC=local
{{- if .CACert}}
            - name: SSL_CERT_DIR
              value: /etc/openctem/certs
{{- end}}
          volumeMounts:
            - name: data
              mountPath: /var/lib/openctem
            - name: tmp
              mountPath: /tmp
            - name: secrets
              mountPath: /run/secrets/openctem
              readOnly: true
{{- if .CACert}}
            - name: ca
              mountPath: /etc/openctem/certs
              readOnly: true
{{- end}}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{$slug}}-data
        - name: tmp
          emptyDir: {}
        - name: secrets
          secret:
            secretName: {{$slug}}
            defaultMode: 0400
            items:
              - key: api-key
                path: api-key
              - key: ldap-password
                path: ldap-password
{{- if .CACert}}
        - name: ca
          secret:
            secretName: {{$slug}}
            items:
              - key: ca.crt
                path: openctem-root-ca.crt
{{- end}}
