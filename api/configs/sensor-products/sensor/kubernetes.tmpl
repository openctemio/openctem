{{- $slug := slugify .Sensor.Name -}}
# {{product}} sensor "{{$slug}}": Kubernetes manifests
# Generated by {{product}} at {{.GeneratedAt}}. Edit
# configs/sensor-products/sensor/kubernetes.tmpl on the API host to change it.
#
# Apply in the namespace the sensor should run in:
{{- if isDaemon .Sensor}}
#   1. Store the sensor-local policy (the "Local policy" tab, saved as
#      sensor-policy.yaml), reviewed by the owner of the scanned network. The
#      sensor refuses every job outside it; without it the pod does not start.
#      Keep write access to this ConfigMap with the network owner:
#        kubectl create configmap {{$slug}}-policy -n <namespace> --from-file=sensor-policy.yaml
#   2. Put the sensor's seccomp profile on every node that may run the pod,
#      at <kubelet root>/seccomp/openctem/sensor-seccomp.json (usually
#      /var/lib/kubelet/seccomp/...), and check it:
#        curl -fsSL -o sensor-seccomp.json {{shellQuote .SeccompURL}}
#        echo '{{.SeccompSHA256}}  sensor-seccomp.json' | sha256sum -c -
#      Each scan task then runs network-confined. Where you cannot write to
#      the nodes, set seccompProfile below to {type: RuntimeDefault}: the
#      sensor then runs unconfined, and jobs that need confinement (a web
#      scope) go to other sensors.
#   3. kubectl apply -n <namespace> -f {{$slug}}.yaml
#   Kill switch: set "kill_switch: true" in the ConfigMap and restart the pod.
#   The policy needs a sensor release later than v0.8.0; v0.8.0 and older
#   ignore it and scan without a local policy.
{{- else}}
#   kubectl apply -n <namespace> -f {{$slug}}.yaml
{{- end}}
{{- if not .APIKey}}
# Replace octs_... below with the sensor's API key first (it is shown once,
# when the sensor is created or its key is rotated).
{{- end}}
apiVersion: v1
kind: Secret
metadata:
  name: {{$slug}}
  labels:
    app.kubernetes.io/name: openctem-sensor
    app.kubernetes.io/instance: {{$slug}}
type: Opaque
stringData:
  api-key: {{if .APIKey}}{{.APIKey}}{{else}}octs_...{{end}}
{{- if .CACert}}
  ca.crt: |
{{indent 4 .CACert}}
{{- end}}
{{- if isDaemon .Sensor}}
---
# The sensor's data: state/ (its identity and the API key it renews on its
# own; the Secret above keeps the key it was installed with, which a renewal
# retires), outbox/ (results that cannot be delivered yet) and content/ (the
# scanner content cache, re-downloadable). Keep it; back it up like a
# credential.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{$slug}}-data
  labels:
    app.kubernetes.io/name: openctem-sensor
    app.kubernetes.io/instance: {{$slug}}
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: 8Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{$slug}}
  labels:
    app.kubernetes.io/name: openctem-sensor
    app.kubernetes.io/instance: {{$slug}}
spec:
  # One sensor identity (one key) and one outbox: a single replica, and the
  # old pod stops before the new one starts.
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/instance: {{$slug}}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: openctem-sensor
        app.kubernetes.io/instance: {{$slug}}
    spec:
      securityContext:
        # The image runs as uid/gid 999; fsGroup lets it write its volumes.
        # OnRootMismatch: the group is set on a new volume only. With the
        # default (Always) every mount makes the files group-readable, and the
        # sensor refuses an identity key its group can read.
        runAsNonRoot: true
        runAsUser: 999
        runAsGroup: 999
        fsGroup: 999
        fsGroupChangePolicy: OnRootMismatch
        # The sensor's own profile (step 2): the runtime default plus new
        # namespaces, for per-task network confinement.
        seccompProfile:
          type: Localhost
          localhostProfile: openctem/sensor-seccomp.json
      containers:
        - name: sensor
          image: {{.Image}}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              # Add NET_RAW only for naabu SYN scans.
              drop: ["ALL"]
          env:
            - name: SENSOR_API_URL
              value: {{yamlQuote .BaseURL}}
            - name: SENSOR_API_KEY
              valueFrom:
                secretKeyRef:
                  name: {{$slug}}
                  key: api-key
            - name: SENSOR_LOCAL_POLICY
              value: /etc/openctem/policy/sensor-policy.yaml
            # The tools keep their settings under /tmp; the image's home
            # directory stays as built (it holds the nuclei-templates
            # release the sensor scans with until its first update).
            - name: XDG_CONFIG_HOME
              value: /tmp/.config
            - name: XDG_CACHE_HOME
              value: /tmp/.cache
{{- if .Policy.AllowPrivate}}
            - name: SENSOR_ALLOW_PRIVATE_TARGETS
              value: "1"
{{- end}}
{{- if .CACert}}
            - name: SSL_CERT_DIR
              value: /etc/openctem/certs
{{- end}}
          volumeMounts:
            - name: data
              mountPath: /var/lib/openctem
            - name: policy
              mountPath: /etc/openctem/policy
              readOnly: true
            # The only writable directory besides the volumes (the root
            # filesystem is read-only).
            - name: tmp
              mountPath: /tmp
{{- if .CACert}}
            - name: ca
              mountPath: /etc/openctem/certs
              readOnly: true
{{- end}}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{$slug}}-data
        - name: policy
          configMap:
            name: {{$slug}}-policy
            defaultMode: 0444
        - name: tmp
          emptyDir: {}
{{- if .CACert}}
        - name: ca
          secret:
            secretName: {{$slug}}
            items:
              - key: ca.crt
                path: openctem-root-ca.crt
{{- end}}
{{- else}}
---
# A one-shot sensor: one scan, then the Job completes. Mount what it should
# scan at /scan (the emptyDir below is a placeholder).
apiVersion: batch/v1
kind: Job
metadata:
  name: {{$slug}}-scan
  labels:
    app.kubernetes.io/name: openctem-sensor
    app.kubernetes.io/instance: {{$slug}}
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        app.kubernetes.io/name: openctem-sensor
        app.kubernetes.io/instance: {{$slug}}
    spec:
      restartPolicy: Never
      containers:
        - name: sensor
          image: {{.Image}}
          args: ["-tool", "{{firstTool .Sensor.EffectiveTools}}", "-target", "/scan", "-push"]
          env:
            - name: SENSOR_API_URL
              value: {{yamlQuote .BaseURL}}
            - name: SENSOR_API_KEY
              valueFrom:
                secretKeyRef:
                  name: {{$slug}}
                  key: api-key
{{- if .CACert}}
            - name: SSL_CERT_DIR
              value: /etc/openctem/certs
{{- end}}
          volumeMounts:
            - name: scan
              mountPath: /scan
{{- if .CACert}}
            - name: ca
              mountPath: /etc/openctem/certs
              readOnly: true
{{- end}}
      volumes:
        - name: scan
          emptyDir: {}
{{- if .CACert}}
        - name: ca
          secret:
            secretName: {{$slug}}
            items:
              - key: ca.crt
                path: openctem-root-ca.crt
{{- end}}
{{- end}}
