# Sensor configuration for {{slugify .Sensor.Name}}
# Generated by {{product}} at {{.GeneratedAt}}
#
# Save as sensor.yaml and run: openctemio-sensor -daemon -config sensor.yaml
# Environment variables (SENSOR_API_URL, SENSOR_API_KEY) override it.
#
# To customize this template, edit configs/sensor-products/sensor/yaml.tmpl on the
# API host (/app/configs/sensor-products/sensor/yaml.tmpl in the container image, or
# the directory set by SENSOR_CONFIG_TEMPLATES_DIR) — no frontend rebuild needed.

sensor:
  name: {{yamlQuote .Sensor.Name}}
  enable_commands: true
  heartbeat_interval: 30s

server:
  base_url: {{yamlQuote .BaseURL}}
  api_key: {{if .APIKey}}{{yamlQuote .APIKey}}{{else}}${SENSOR_API_KEY}{{end}}
  sensor_id: {{.Sensor.ID}}

# Results not yet accepted by the platform wait here. The sensor's data
# directory /var/lib/openctem holds outbox/, state/ and content/: keep it on
# persistent storage so a restart or an outage loses nothing.
outbox:
  dir: /var/lib/openctem/outbox

# The sensor keeps its state, including the API key it renews on its own, in
# SENSOR_STATE_DIR (default /var/lib/openctem/state, else ~/.openctem). Keep
# that directory: without it the sensor starts with api_key above, which a
# renewal has retired.

# Tools: the sensor finds the ones it can run (a registered tool whose binary
# is installed), so the sensor build defines the tool set. Narrow it in the
# local policy's tools.allow rather than listing scanners here: a list here
# pins the sensor to those tools even after an upgrade adds new ones.
