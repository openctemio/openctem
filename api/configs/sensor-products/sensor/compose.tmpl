{{- $slug := slugify .Sensor.Name -}}
# {{product}} sensor "{{$slug}}": Docker Compose
# Generated by {{product}} at {{.GeneratedAt}}. Edit
# configs/sensor-products/sensor/compose.tmpl on the API host to change it.
#
# In an empty directory on the host that should scan:
#   1. Put the sensor's API key in .env (kept out of this file):
{{- if .APIKey}}
#        printf '%s\n' 'OPENCTEM_API_KEY={{.APIKey}}' > .env && chmod 600 .env
{{- else}}
#        printf '%s\n' 'OPENCTEM_API_KEY=octs_...' > .env && chmod 600 .env
#      (the key is shown once, when the sensor is created or its key rotated)
{{- end}}
{{- if isDaemon .Sensor}}
#   2. Save the "Local policy" tab as policy/sensor-policy.yaml, after the
#      owner of the scanned network reviewed it (the sensor refuses every job
#      outside it; without the file it does not start), owned by root and
#      read-only:
#        sudo install -D -m 0644 -o root sensor-policy.yaml policy/sensor-policy.yaml
#   3. Download the sensor's seccomp profile next to compose.yaml and check
#      it (each scan task then runs network-confined; keep Docker's default
#      AppArmor profile):
#        curl -fsSL{{if .CACert}} --cacert openctem-root-ca.crt{{end}} -o sensor-seccomp.json {{shellQuote .SeccompURL}}
#        echo '{{.SeccompSHA256}}  sensor-seccomp.json' | sha256sum -c -
{{- if .CACert}}
#      (openctem-root-ca.crt: the platform's CA, the PEM under configs below)
{{- end}}
#   4. Save this file as compose.yaml and run: docker compose up -d
#   Kill switch (no job runs while the file exists): sudo touch policy/STOP
#   The policy and the kill switch need a sensor release later than v0.8.0;
#   v0.8.0 and older ignore them and scan without a local policy.
{{- else}}
#   2. Save this file as compose.yaml and run: docker compose up -d
{{- end}}
{{- if .CACert}}
#   The platform's private CA is embedded below (configs.content needs
#   Docker Compose 2.23.1 or later).
{{- end}}
services:
  sensor:
    image: {{.Image}}
    container_name: {{$slug}}
    restart: {{if isDaemon .Sensor}}unless-stopped{{else}}"no"{{end}}
{{- if not (isDaemon .Sensor)}}
    # A one-shot sensor: scans ./src once and sends the results.
    command: ["-tool", "{{firstTool .Sensor.EffectiveTools}}", "-target", "/scan", "-push"]
{{- end}}
{{- if isDaemon .Sensor}}
    # Hardened: read-only root filesystem, no capabilities, no privilege
    # escalation, the sensor's seccomp profile (per-task network
    # confinement); add NET_RAW to cap_add only for naabu SYN scans. The
    # sensor writes only /tmp besides its volumes (its tools too: XDG_*
    # below); the image's home directory keeps the nuclei-templates release
    # the sensor scans with until its first update.
    read_only: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true", "seccomp=./sensor-seccomp.json"]
    tmpfs: [/tmp]
{{- end}}
    environment:
      SENSOR_API_URL: {{yamlQuote .BaseURL}}
      SENSOR_API_KEY: ${OPENCTEM_API_KEY:?set OPENCTEM_API_KEY in .env}
{{- if isDaemon .Sensor}}
      SENSOR_LOCAL_POLICY: /etc/openctem/policy/sensor-policy.yaml
      SENSOR_KILL_SWITCH_FILE: /etc/openctem/policy/STOP
      XDG_CONFIG_HOME: /tmp/.config
      XDG_CACHE_HOME: /tmp/.cache
{{- if .Policy.AllowPrivate}}
      SENSOR_ALLOW_PRIVATE_TARGETS: "1"
{{- end}}
{{- end}}
{{- if .CACert}}
      SSL_CERT_DIR: /etc/openctem/certs
{{- end}}
    volumes:
      # One data volume: state/, outbox/ and content/ (see below).
      - data:/var/lib/openctem
{{- if isDaemon .Sensor}}
      # The sensor-local policy and the kill switch, read-only.
      - ./policy:/etc/openctem/policy:ro
{{- end}}
{{- if not (isDaemon .Sensor)}}
      - ./src:/scan:ro
{{- end}}
{{- if .CACert}}
    configs:
      - source: openctem_ca
        target: /etc/openctem/certs/openctem-root-ca.crt
        mode: 0444
{{- end}}

volumes:
  # The sensor's data. Keep it and back it up like a credential:
  #   outbox/   results that cannot be delivered yet (a restart or an outage
  #             loses nothing)
{{- if isDaemon .Sensor}}
  #   state/    the sensor's identity and the API key it renews on its own
  #             (without it the sensor starts with the key in .env, which a
  #             renewal has retired)
  #   content/  scanner content cache (trivy DB, nuclei templates, semgrep
  #             rules); it can be deleted, the sensor downloads it again
{{- end}}
  data:
{{- if .CACert}}

configs:
  openctem_ca:
    content: |
{{indent 6 .CACert}}
{{- end}}
