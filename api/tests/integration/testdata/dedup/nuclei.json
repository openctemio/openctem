    {"name": "a newer producer that reports the method only in the web location keeps the finding", "expect": "same", "before": {"type": "vulnerability", "title": "t", "severity": "medium", "rule_id": "exposed-env", "location": {"path": "https://shop.example.com/.env"}, "properties": {"request": "GET /.env HTTP/1.1"}}, "after": {"type": "vulnerability", "title": "t", "severity": "medium", "rule_id": "exposed-env", "location": {"path": "https://shop.example.com/.env"}, "web": {"url": "https://shop.example.com/.env", "method": "GET"}}},
    {"name": "a producer that reports no method keeps the GET finding", "expect": "same", "before": {"type": "vulnerability", "title": "t", "severity": "medium", "rule_id": "exposed-git", "location": {"path": "https://shop.example.com/.git/config"}, "properties": {"request": "GET /.git/config HTTP/1.1"}}, "after": {"type": "vulnerability", "title": "t", "severity": "medium", "rule_id": "exposed-git", "location": {"path": "https://shop.example.com/.git/config"}}},
