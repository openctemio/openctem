    {"name": "endpoints given as targets stay one finding per endpoint", "expect": "different", "before": {"type": "vulnerability", "title": "t", "severity": "medium", "rule_id": "reflected-xss", "location": {"path": "https://shop.example.com/search"}, "source_extra": {"target": "https://shop.example.com/search"}}, "after": {"type": "vulnerability", "title": "t", "severity": "medium", "rule_id": "reflected-xss", "location": {"path": "https://shop.example.com/profile"}, "source_extra": {"target": "https://shop.example.com/profile"}}},
    {"name": "a fuzzed parameter is keyed per endpoint and parameter, not on the target", "expect": "different", "before": {"type": "vulnerability", "title": "t", "severity": "medium", "rule_id": "sqli-dast", "location": {"path": "https://shop.example.com/a"}, "source_extra": {"target": "https://shop.example.com"}, "web": {"url": "https://shop.example.com/a", "method": "GET", "parameter": {"location": "query", "name": "id"}}}, "after": {"type": "vulnerability", "title": "t", "severity": "medium", "rule_id": "sqli-dast", "location": {"path": "https://shop.example.com/b"}, "source_extra": {"target": "https://shop.example.com"}, "web": {"url": "https://shop.example.com/b", "method": "GET", "parameter": {"location": "query", "name": "id"}}}},
    {"name": "a fixed-path finding keyed on its matched URL before the target was reported keeps its row", "expect": "same", "before": {"type": "vulnerability", "title": "t", "severity": "medium", "rule_id": "wp-user-enum", "location": {"path": "https://shop.example.com/wp-json/wp/v2/users"}, "properties": {"request": "GET /wp-json/wp/v2/users HTTP/1.1"}}, "after": {"type": "vulnerability", "title": "t", "severity": "medium", "rule_id": "wp-user-enum", "location": {"path": "https://shop.example.com/wp-json/wp/v2/users"}, "source_extra": {"target": "https://shop.example.com"}, "web": {"url": "https://shop.example.com/wp-json/wp/v2/users", "method": "GET"}}}
