# OpenCTEM API: local development settings. Copy to .env.
#
# GENERATED from internal/config/env_registry.yaml by "make env-docs"; edit the
# registry, not this file. It lists only what a development checkout sets;
# every other variable keeps its default (full list with defaults:
# docs/configuration/environment-variables.md). Production installs start from
# deploy/.env.example instead.
#
# The keys below are the public development keys: the API refuses them unless
# APP_ENV=development.

# --- Application ---------------------------------------------------------------
# Environment name. production (also when unset) turns on the production checks
# (TLS to PostgreSQL and Redis, strong secrets, rate limiting, secure cookies;
# server -check-config reports them). Any value other than development requires
# APP_ENCRYPTION_KEY, refuses the published development secrets and defaults
# AUTH_COOKIE_SECURE to true. Set development explicitly for a local or trial
# setup without TLS to the datastores. Up to v0.8.0 an unset value meant
# development.
APP_ENV=development
# Public origin of the platform (https://ctem.example.com): the one URL
# browsers, sensors and e-mail links use. Set it in every deployment. When set,
# it is the default of CORS_ALLOWED_ORIGINS, SMTP_BASE_URL and
# OAUTH_FRONTEND_CALLBACK_URL, and SAML service-provider URLs and the sensor
# endpoint are built from it. Must be an http(s) URL without credentials, query
# or fragment.
APP_URL=http://localhost:8080

# --- Database (PostgreSQL) -----------------------------------------------------
# PostgreSQL host.
DB_HOST=localhost
# Password of DB_USER. Required outside APP_ENV=development; there is no
# default.
DB_PASSWORD=secret
# Role the API connects as. With the least-privilege layout this is the
# DML-only role (openctem_app).
DB_USER=openctem

# --- Redis ---------------------------------------------------------------------
# Redis host.
REDIS_HOST=localhost

# --- Logging -------------------------------------------------------------------
# debug, info, warn or error. Production refuses debug.
LOG_LEVEL=debug

# --- Encryption keys -----------------------------------------------------------
# AES-256-GCM key for stored credentials (integration tokens, SMTP passwords,
# identity-provider secrets). 32 raw, 64 hex or 44 base64 characters: openssl
# rand -hex 32. Required unless APP_ENV=development. Back it up with the
# database: without it the stored credentials cannot be decrypted.
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Server secret the fingerprint of each reported secret finding is keyed from
# (and the key CI jobs hash raw secrets with). At least 32 characters: openssl
# rand -hex 32. Never rotate it with APP_ENCRYPTION_KEY: changing it changes
# every secret's identity, so a secret seen again opens a second finding. On an
# install that already stores secret findings, set it to the current
# APP_ENCRYPTION_KEY value (the key those fingerprints were made with).
# Required unless APP_ENV=development, where APP_ENCRYPTION_KEY is used when it
# is unset. Back it up with the database.
FINGERPRINT_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# --- Authentication ------------------------------------------------------------
# Secure flag on session cookies. Must be true in production.
AUTH_COOKIE_SECURE=false
# Require a verified email address. Production refuses false with local or
# hybrid.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# --- Single sign-on and social login -------------------------------------------
# Master switch for social login (Google, GitHub, Microsoft). A provider is
# offered only when its own *_ENABLED, client ID and secret are set.
OAUTH_ENABLED=false
# Web console URL the social-login and SSO flows return to. Set it only when
# the console is not at APP_URL.
OAUTH_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback

# --- CORS and rate limiting ----------------------------------------------------
# Comma-separated browser origins allowed to call the API; the WebSocket Origin
# is checked against it too. Set it only when the console runs on another
# origin than APP_URL. Production refuses *.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Email (SMTP) --------------------------------------------------------------
# Base URL of links in e-mails. Set it only when the console is not at APP_URL.
SMTP_BASE_URL=http://localhost:3000

# --- Authentication ------------------------------------------------------------
# Public origin of the platform console (https://<OPENCTEM_ADMIN_HOST> or
# https://<host>:8443 when the console has its own site). It is the console's
# WebAuthn relying party: security keys and passkeys registered there are bound
# to its host, and assertions from any other origin are refused. Changing the
# host makes registered keys unusable (administrators sign in with TOTP or a
# recovery code and register again). Empty and no APP_URL: console security
# keys are off.
ADMIN_PUBLIC_URL=https://admin.ctem.example.com
