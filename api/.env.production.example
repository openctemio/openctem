# =============================================================================
# Production Environment Configuration
# =============================================================================
# Copy this to .env and update all <CHANGE_ME> values before deployment
# Validate with: APP_ENV=production go run cmd/server/main.go

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=openctem
APP_ENV=production
APP_DEBUG=false
# Public origin of this API (scheme://host[:port]). SAML SP entity ID / ACS URL
# are built from it; when unset they fall back to the request Host, and
# X-Forwarded-* is honored only from SERVER_TRUSTED_PROXIES.
APP_URL=https://api.example.com

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_REQUEST_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=30s
SERVER_MAX_BODY_SIZE=1048576

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# REQUIRED: SSL must be enabled in production
DB_HOST=<CHANGE_ME_DB_HOST>
DB_PORT=5432
DB_USER=<CHANGE_ME_DB_USER>
DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
DB_NAME=openctem
DB_SSLMODE=require
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# REQUIRED: Password and TLS must be enabled in production
REDIS_HOST=<CHANGE_ME_REDIS_HOST>
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME_MIN_32_CHARS>
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
# TLS Settings (REQUIRED in production)
REDIS_TLS_ENABLED=true
REDIS_TLS_SKIP_VERIFY=false
# Retry Settings
REDIS_MAX_RETRIES=3
REDIS_MIN_RETRY_DELAY=100ms
REDIS_MAX_RETRY_DELAY=3s

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Use "info" or "warn" in production (never "debug")
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Auth provider: "local" | "oidc" | "hybrid"
AUTH_PROVIDER=local

# REQUIRED for local auth: JWT secret (min 64 characters)
# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=<CHANGE_ME_GENERATE_WITH_OPENSSL>
AUTH_JWT_ISSUER=api

# Token durations
AUTH_ACCESS_TOKEN_DURATION=15m
AUTH_REFRESH_TOKEN_DURATION=168h
AUTH_SESSION_DURATION=720h

# Password policy
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_NUMBER=true
AUTH_PASSWORD_REQUIRE_SPECIAL=false

# Security settings
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=15m
AUTH_MAX_ACTIVE_SESSIONS=10

# Registration
AUTH_ALLOW_REGISTRATION=false
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Session cookies (refresh/access/tenant, CSRF, admin console) carry the
# Secure flag. Defaults to true unless APP_ENV=development; production
# refuses to start with it false.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# Keycloak (Optional - only for oidc or hybrid auth)
# -----------------------------------------------------------------------------
# KEYCLOAK_BASE_URL=https://<CHANGE_ME_KEYCLOAK_HOST>
# KEYCLOAK_REALM=<CHANGE_ME_REALM>
# KEYCLOAK_CLIENT_ID=<CHANGE_ME_CLIENT_ID>
# KEYCLOAK_JWKS_REFRESH_INTERVAL=1h
# KEYCLOAK_HTTP_TIMEOUT=10s

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# REQUIRED: Specify exact allowed origins (NO wildcards in production)
CORS_ALLOWED_ORIGINS=https://<CHANGE_ME_FRONTEND_DOMAIN>
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Request-ID
CORS_MAX_AGE=86400

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
RATE_LIMIT_CLEANUP=1m

# -----------------------------------------------------------------------------
# SMTP Email (Optional - for email verification, password reset)
# -----------------------------------------------------------------------------
SMTP_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=<CHANGE_ME>
# SMTP_PASSWORD=<CHANGE_ME>
# SMTP_FROM=noreply@openctem.io
# SMTP_FROM_NAME=OpenCTEM
# SMTP_TLS=true
# SMTP_BASE_URL=https://<CHANGE_ME_FRONTEND_DOMAIN>

# -----------------------------------------------------------------------------
# Connectors (Optional)
# -----------------------------------------------------------------------------
# Wiz Integration
#WIZ_CLIENT_ID=
#WIZ_CLIENT_SECRET=
#WIZ_AUTH_URL=
#WIZ_API_URL=

# Tenable Integration
#TENABLE_ACCESS_KEY=
#TENABLE_SECRET_KEY=

# -----------------------------------------------------------------------------
# AI Triage Configuration
# -----------------------------------------------------------------------------
# AI triage is automatically enabled when LLM API key is configured.
# Feature availability controlled by module is_active in database.
# DEPRECATED: AI_TRIAGE_ENABLED is no longer used.

# Platform LLM Provider: "claude" | "openai" | "gemini"
AI_PLATFORM_PROVIDER=claude
AI_PLATFORM_MODEL=claude-sonnet-4-20250514

# LLM API Keys - Configure at least one to enable AI triage
# Only configure the key matching your AI_PLATFORM_PROVIDER
ANTHROPIC_API_KEY=<CHANGE_ME_IF_USING_CLAUDE>
#OPENAI_API_KEY=<CHANGE_ME_IF_USING_OPENAI>
#GEMINI_API_KEY=<CHANGE_ME_IF_USING_GEMINI>

# Processing Limits
AI_MAX_CONCURRENT_JOBS=10
# Hard cap on LLM completions per minute, enforced in front of every provider
# call. Shared by everything spending the same API key (platform-mode tenants
# share the platform key; each BYOK tenant gets its own). 0 = no limit.
AI_RATE_LIMIT_RPM=60
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=2000

# Auto-Triage Settings
# PLATFORM defaults, applied only to tenants that have not set the
# corresponding key themselves. A tenant's explicit choice always wins.
AI_AUTO_TRIAGE_DEFAULT_ENABLED=false
AI_AUTO_TRIAGE_DEFAULT_SEVERITIES=critical,high
AI_AUTO_TRIAGE_DELAY=60s

# =============================================================================
# Admin Audit Log Retention
# =============================================================================
# Prunes the platform-level admin_audit_logs table, which is otherwise
# append-only and unbounded. DRY_RUN defaults to true so an upgrade never
# silently deletes audit history: review the "dry run - would delete audit
# logs" WARN entries, take a backup, then set DRY_RUN=false to enforce.
ADMIN_AUDIT_RETENTION_ENABLED=true
ADMIN_AUDIT_RETENTION_DRY_RUN=true
# Must be >= 30 when DRY_RUN=false; the server refuses to boot otherwise.
ADMIN_AUDIT_RETENTION_DAYS=365
ADMIN_AUDIT_RETENTION_INTERVAL=24h
ADMIN_AUDIT_RETENTION_BATCH_SIZE=10000

# Tenant audit log retention (hourly). Entries older than AUDIT_RETENTION_DAYS
# (minimum 365) are written to a gzip JSONL archive under AUDIT_ARCHIVE_DIR,
# the hash-chain head they leave is recorded (audit_chain_anchors), then they
# are deleted; the remaining chain still verifies. Empty AUDIT_ARCHIVE_DIR:
# nothing is deleted. Back the directory up like the database.
AUDIT_RETENTION_DAYS=365
AUDIT_ARCHIVE_DIR=

# =============================================================================
# Sensor Load Balancing
# =============================================================================
# Weights for the sensor load score (lower = better placement target); should
# sum to 1.0. Recomputed on every heartbeat and used by the scheduler, so
# tuning these changes where jobs land.
SENSOR_LB_JOB_WEIGHT=0.30
SENSOR_LB_CPU_WEIGHT=0.40
SENSOR_LB_MEMORY_WEIGHT=0.15
SENSOR_LB_DISK_IO_WEIGHT=0.10
SENSOR_LB_NETWORK_WEIGHT=0.05
SENSOR_LB_MAX_DISK_THROUGHPUT_MBPS=500
SENSOR_LB_MAX_NETWORK_THROUGHPUT_MBPS=1000

# Heartbeat doorbell (RFC-023 §9.2a): the interval the heartbeat response
# advises in next_heartbeat_seconds. Clamped to [MIN, MAX], and MAX to half of
# WORKER_HEARTBEAT_TIMEOUT so a sensor following the advice never goes offline.
# SENSOR_HEARTBEAT_INTERVAL=30s
# SENSOR_HEARTBEAT_BUSY_INTERVAL=5s
# SENSOR_HEARTBEAT_LOADED_INTERVAL=2m
# SENSOR_HEARTBEAT_MIN_INTERVAL=5s
# SENSOR_HEARTBEAT_MAX_INTERVAL=5m
# Doorbell query latency that counts as "platform under load".
# SENSOR_HEARTBEAT_SLOW_QUERY=250ms
# How long a renewed sensor API key stays valid (default 2160h = 90 days; 0 =
# renewed keys never expire). Sensors renew on their own (SDK v0.12+, when
# their state volume persists); keys created or regenerated by an
# administrator never expire, and a sensor that does not renew keeps its key.
# SENSOR_KEY_TTL=2160h
# Ring rotate_key this long before the presented key expires (default: half of
# SENSOR_KEY_TTL, or 24h).
# SENSOR_KEY_RENEW_BEFORE=
# Secret the sensor API-key hash (HMAC-SHA256) is keyed with. Default: derived
# from APP_ENCRYPTION_KEY with HKDF (a different key from the encryption key).
# Keys stored under the old pepper (APP_ENCRYPTION_KEY itself, before RFC-032
# Phase 0) keep working. At least 32 characters: openssl rand -hex 32.
# SENSOR_KEY_PEPPER=
# When replacing SENSOR_KEY_PEPPER, list the old value(s) here (comma-separated)
# so keys stored under them keep working until they are renewed.
# SENSOR_KEY_PEPPER_PREVIOUS=

# Sensor release channel (Sensors page). Each sensor's version is compared with
# it: "update available" below LATEST, degraded + "unsupported" below MIN. The
# install snippets pin the sensor image to LATEST. Default LATEST: the newest
# sensor release when this API was built; "none" turns it off. MIN: none.
# SENSOR_LATEST_VERSION=v0.4.2
# SENSOR_MIN_VERSION=v0.4.0
# SDK policy: the SDK each sensor is built with (heartbeat "sdk" member, or its
# User-Agent). Below MIN: degraded + "SDK below minimum"; below LATEST: "outdated".
# Default: none for both.
# SENSOR_SDK_MIN_VERSION=v0.8.0
# SENSOR_SDK_LATEST_VERSION=v0.9.0
# Sensor image the install snippets run (tag = SENSOR_LATEST_VERSION).
# SENSOR_IMAGE=ghcr.io/openctemio/sensor
# The platform's private CA, installed by the snippets on the sensor host. With
# the built-in gateway in TLS mode internal, mount its CA export directory into
# the API read-only and point this at the exported root.
# SENSOR_CA_CERT_FILE=/ca/openctem-root-ca.crt
