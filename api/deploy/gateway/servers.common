# Settings of every HTTP server of the gateway (imported by the Caddyfile's
# global `servers` blocks: the main site's listener and every other one, such
# as the platform console's site).
# Sensors and browsers speak HTTP/1.1 and HTTP/2; no QUIC (UDP) listener.
protocols h1 h2
# Proxies in front of this gateway whose X-Forwarded-For is believed.
# Default: none (127.0.0.1 never connects from outside), so a client
# cannot choose its own address. Set only for the `http` mode or an L4/L7
# load balancer in front: space-separated CIDRs.
trusted_proxies static {$OPENCTEM_TRUSTED_PROXIES:127.0.0.1/32}
# Which header such a proxy puts the client's address in, tried in
# order (OPENCTEM_CLIENT_IP_HEADERS, checked by the entrypoint):
# X-Forwarded-For (default), or Cf-Connecting-Ip behind a Cloudflare
# Tunnel, whose edge sets that header to the one visitor address.
# Read only when the connecting peer is one of the proxies above;
# from any other peer the headers are ignored.
client_ip_headers {$OPENCTEM_CLIENT_IP_HEADERS:X-Forwarded-For}
# Read X-Forwarded-For right to left: the client is the right-most
# entry that is not one of the proxies above. The default (left-most)
# is whatever the client typed when the front proxy appends, and
# {client_ip} is what this gateway sends the API (see `forwarded`).
trusted_proxies_strict
