# =============================================================================
# OpenCTEM gateway: the single public entry point (one HTTPS port).
# =============================================================================
# The browser UI (web, Next.js) and the REST API (api, Go) stay on the internal
# network. This gateway terminates TLS and routes by plane (RFC-041), from
# planes.caddy, which is GENERATED from the API's plane table
# (api/internal/infra/http/routes/plane), the same table the route-style lint
# checks every route against; CI fails if the two disagree:
#
#   to the API (api:8080), by plane
#     sensor   /api/v2/sensor/*  /api/v1/agent/*  /api/v1/validation/evidence
#     inbound  /hooks/*  /api/v1/webhooks/incoming/*        (HMAC per tenant)
#     scim     /scim/v2/*
#     mcp      /api/v1/mcp                                  (oct_ key)
#     ops      /health  /openapi.yaml  /docs
#     auth     /api/v1/auth/saml/*  /api/v1/auth/backchannel-logout   (called by the IdP)
#     self     /api/v1/ws                                   (browser WebSocket, same origin)
#   blocked here (404): /metrics  /ready  /debug/*
#   browser planes (user, self, auth, admin): everything else under /api goes
#     to the API only for token clients:
#       Authorization: Bearer oct_*  or  X-API-Key          API-key clients
#                                                           (tenant REST routes, read-only;
#                                                           see docs/architecture/api-keys.md)
#       Authorization: Bearer * and no session cookie       other token clients
#     and to the web UI (web:3000) otherwise, including the browser's
#     cookie-session calls to /api/v1/*, which the web proxy authenticates.
#
# Why the credential split: the web's /api/v1 proxy authenticates with the
# browser's session cookie and does not forward the caller's Authorization
# header, so a token client sent there gets 401. A browser always carries the
# session cookie, so "Bearer and no session cookie" is never a browser call.
#
# TLS is chosen by OPENCTEM_TLS_MODE (internal | acme | files | http); each
# mode is a pair of small files under modes/. Environment placeholders
# {$NAME:default} are substituted when the file is read.
# =============================================================================
{
	# Admin API stays inside the container (the healthcheck uses it).
	admin 127.0.0.1:2019

	# Runtime log: plain text, not JSON, so `docker logs` is readable.
	log default {
		output stdout
		format console {
			level_format upper
		}
		# The healthcheck polls the admin API every 30s; keep that out of the log.
		exclude admin.api
	}

	servers {
		# Sensors and browsers speak HTTP/1.1 and HTTP/2; no QUIC (UDP) listener.
		protocols h1 h2
		# Proxies in front of this gateway whose X-Forwarded-For is believed.
		# Default: none (127.0.0.1 never connects from outside), so a client
		# cannot choose its own address. Set only for the `http` mode or an L4/L7
		# load balancer in front: space-separated CIDRs.
		trusted_proxies static {$OPENCTEM_TRUSTED_PROXIES:127.0.0.1/32}
		client_ip_headers X-Forwarded-For
		# Read X-Forwarded-For right to left: the client is the right-most
		# entry that is not one of the proxies above. The default (left-most)
		# is whatever the client typed when the front proxy appends, and
		# {client_ip} is what this gateway writes into X-Real-IP for the API.
		trusted_proxies_strict
	}

	import modes/{$OPENCTEM_TLS_MODE}.global
}

# The plane matchers, generated from the API's plane table.
import planes.caddy

# Everything a site needs apart from its address and TLS.
(openctem) {
	# Above the API's largest per-route limit (asset import, 200 MB); the API
	# enforces the real per-route limits. Bodies are streamed, not buffered.
	request_body {
		max_size {$GATEWAY_MAX_BODY_SIZE:256MB}
	}

	# Access log: one readable line per request. Secrets are removed:
	# Authorization/Cookie are redacted by Caddy itself; API keys sent as
	# headers are removed here. Invitation tokens travel in the body or the
	# URL fragment (never sent to a server), but the deprecated API aliases and
	# links emailed before RFC-041 still carry one in the path
	# (/api/v1/invitations/{token}/..., /invitations/{token}): it is replaced.
	# So is a WebSocket `?ticket=`: the API no longer issues one (RFC-045), but
	# this file is also the Helm chart's gateway, which can front an older API.
	# One regexp, because a log field takes one filter.
	log {
		output stdout
		format filter {
			wrap console {
				level_format upper
			}
			fields {
				request>headers>X-Api-Key delete
				request>headers>X-Sensor-Api-Key delete
				request>headers>X-Csrf-Token delete
				request>uri regexp "^(/api/v1/invitations/|/invitations/)[A-Za-z0-9_-]{20,}|([?&]ticket=)[^&]*" "${1}${2}REDACTED"
			}
		}
	}

	# Defaults only (`?`): the web UI sets its own frame/CSP/referrer headers,
	# which win. These cover API responses.
	header {
		-Server
		-Via
		?X-Content-Type-Options nosniff
		?X-Frame-Options DENY
		?Referrer-Policy strict-origin-when-cross-origin
	}

	# Never public: debug handlers (no plane). Metrics and readiness are the
	# ops plane's internal paths, in planes.caddy.
	@debug path /debug /debug/*
	handle @debug {
		respond 404
	}

	# The planes the gateway sends straight to the API (generated).
	import planes

	@api_key_bearer {
		path /api/*
		header Authorization "Bearer oct_*"
	}
	handle @api_key_bearer {
		import to_api
	}

	@api_key_header {
		path /api/*
		header X-API-Key *
	}
	handle @api_key_header {
		import to_api
	}

	@token_no_session {
		path /api/*
		header Authorization "Bearer *"
		not header Cookie *{$AUTH_COOKIE_NAME:auth_token}=*
	}
	handle @token_no_session {
		import to_api
	}

	handle {
		reverse_proxy {$OPENCTEM_WEB_UPSTREAM:web:3000} {
			import forwarded
		}
	}
}

(to_api) {
	reverse_proxy {$OPENCTEM_API_UPSTREAM:api:8080} {
		import forwarded
	}
}

# The client address for the API's audit log, rate limits and IP allowlists.
# Caddy already sets X-Forwarded-For/-Proto/-Host and drops any a client sent;
# X-Real-IP is not touched by Caddy, so it is overwritten here (the API reads
# it first, and only from SERVER_TRUSTED_PROXIES peers; see
# pkg/httpsec/clientip.go). Responses are flushed immediately (long polls, SSE, streaming).
(forwarded) {
	header_up X-Real-IP {client_ip}
	flush_interval -1
}

# Port 80 for TLS modes internal and files, which turn off Caddy's automatic
# redirect: a browser that types http://<host> is sent to HTTPS instead of
# getting "connection refused". Nothing is served over plain HTTP, and the
# container port is reachable only when docker-compose.http-redirect.yml
# publishes it. Mode acme gets the same from Caddy itself.
(http_redirect) {
	http:// {
		# 308, not 301: a client's POST/PUT stays a POST/PUT.
		redir https://{host}{uri} 308
	}
}

import modes/{$OPENCTEM_TLS_MODE}.site
