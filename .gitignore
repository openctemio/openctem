# Root-level ignores. server/.gitignore and web/.gitignore keep their own
# language-specific rules; this file covers what bites at the root.

# Secrets / env (whitelist examples)
.env
.env.*
!.env.example
!*.env.example

# Local Go workspace files (GOWORK=off is the CI default)
go.work
go.work.sum

# Sibling checkouts that CI's Security Gates job (and local security-lint runs)
# place next to server/: <root>/{server,agent,sdk-go}
/agent/
/sdk-go/

# Editors / OS
.DS_Store
.idea/
*.swp

# Worktrees created inside the checkout by mistake
/.worktrees/
/worktrees/

# Generated contract files: produced by `make generate` (CI, image builds and
# local dev), never committed, so pull requests cannot conflict on them. See
# server/docs/development/ci-cd.md, "Generated contract files".
/server/api/openapi/swagger.yaml
/server/api/openapi/swagger.json
/server/api/openapi/docs.go
/server/api/openapi/routes.txt
/web/src/lib/api/generated/api.types.ts
/web/src/config/api-route-permissions.json
/web/src/config/authz-matrix.json

# Python bytecode
__pycache__/
*.pyc

# scratch output from local test runs
/*.out
/*.txt
/*.log
/server/*.txt
/server/*.out
/web/*.txt
/web/*.out

# Runtime data written by a local API (sensor CA key, attachments, feeds). Never commit.
/data/

# Local editor/agent permission files (machine-specific paths)
**/.claude/settings.local.json

# Extension mount points: an extension's web code is copied in by its own
# build and never tracked here. The edition fence check
# (.github/scripts/check-edition-fence.sh) fails when any of this is tracked.
/web/src/extensions/
/web/src/app/**/(extensions)/
/web/console/src/app/**/(extensions)/
