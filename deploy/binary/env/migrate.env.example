# /etc/openctem/migrate.env: the schema owner's connection for
# openctem-migrate.service. Owner root, group openctem, mode 0640.
# The URL carries no password: golang-migrate reads it from PGPASSWORD, so it
# never shows in a process list.
DATABASE_MIGRATE_URL=postgres://openctem_migrator@db.example.internal:5432/openctem?sslmode=verify-full
PGPASSWORD=change-me-openssl-rand-hex-24
