# /etc/openctem/signer.env: settings of openctem-signer (openctem-signer.service).
# Owner root, mode 0640, group openctem. It holds no secret: the key itself
# lives in /var/lib/openctem-signer/keys (0700, user openctem-signer).
SIGNER_KEY_FILE=/var/lib/openctem-signer/keys/signer.pem
SIGNER_STATE_DIR=/var/lib/openctem-signer/state
SIGNER_SOCKET=/run/openctem-signer/signer.sock
# Creates the key on first start. Or create it yourself:
#   sudo -u openctem-signer /opt/openctem/server/bin/openctem-signer keygen -out /var/lib/openctem-signer/keys/signer.pem
SIGNER_GENERATE_KEY=true
