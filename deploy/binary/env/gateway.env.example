# /etc/openctem/gateway.env: settings of the gateway (openctem-gateway.service).
# Owner root, group openctem-gateway, mode 0640. The settings are those of the
# gateway container: api/docs/deployment/docker.md, "Gateway".
OPENCTEM_TLS_MODE=internal
OPENCTEM_HOSTNAME=ctem.example.com
#ACME_EMAIL=ops@example.com
# TLS mode files: the certificate directory (readable by openctem-gateway).
#OPENCTEM_CERT_DIR=/etc/openctem/tls
#TLS_CERT_FILE=tls.crt
#TLS_KEY_FILE=tls.key

# The services on this host.
OPENCTEM_API_UPSTREAM=127.0.0.1:8080
OPENCTEM_WEB_UPSTREAM=127.0.0.1:3000
OPENCTEM_CONSOLE_UPSTREAM=127.0.0.1:3001
SENSOR_MTLS_UPSTREAM=127.0.0.1:9443

# The platform console site: its own port, reachable from these ranges only.
OPENCTEM_ADMIN_SITE=port
OPENCTEM_ADMIN_PORT=8443
OPENCTEM_ADMIN_ALLOWED_CIDRS=127.0.0.0/8 ::1/128 10.0.0.0/8
GATEWAY_MAX_BODY_SIZE=256MB
