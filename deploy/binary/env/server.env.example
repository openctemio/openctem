# /etc/openctem/server.env: settings of openctem-server (systemd unit
# openctem-server.service). Owner root, group openctem, mode 0640: it holds
# secrets. Every setting: api/docs/operations/environment-variables.md (and
# `openctem-server -check-config` validates this file without connecting).
# Values below are placeholders: generate each secret, never reuse the examples.

APP_NAME=openctem
APP_ENV=production
APP_URL=https://ctem.example.com

# Listeners. The gateway on the same host reaches the API on loopback.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# The platform console API (console app only), loopback.
ADMIN_LISTEN_ADDR=127.0.0.1:8081
# The gateway and the web servers on this host.
SERVER_TRUSTED_PROXIES=127.0.0.1,::1

# Database: the API's own role (not the schema owner; see migrate.env).
DB_HOST=db.example.internal
DB_PORT=5432
DB_NAME=openctem
DB_USER=openctem_app
DB_PASSWORD=change-me-openssl-rand-hex-24
DB_SSLMODE=verify-full
# The platform console's database role (optional; api/docs/deployment/database-roles.md).
#DB_ADMIN_USER=openctem_console
#DB_ADMIN_PASSWORD=

REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me-32-characters-or-more
REDIS_TLS_ENABLED=true
#REDIS_TLS_CA_FILE=/etc/openctem/tls/redis-ca.crt

AUTH_PROVIDER=local
AUTH_COOKIE_SECURE=true
# openssl rand -hex 32
APP_ENCRYPTION_KEY=
FINGERPRINT_KEY=
SIGNUP_MODE=disabled

# Writable data, under the unit's StateDirectory.
STORAGE_LOCAL_PATH=/var/lib/openctem/server/attachments
SENSOR_MTLS_CA_DIR=/var/lib/openctem/server/sensor-ca
# The gateway's internal CA root, exported by openctem-gateway (TLS mode internal).
#SENSOR_CA_CERT_FILE=/var/lib/openctem/gateway/ca-export/openctem-root-ca.crt

# The job signer's socket (openctem-signer.service).
SIGNER_SOCKET=/run/openctem-signer/signer.sock

SYSTEM_WEB_HEALTH_URL=http://127.0.0.1:3000/api/health
SYSTEM_GATEWAY_HEALTH_URL=http://127.0.0.1:2020/health

LOG_LEVEL=info
LOG_FORMAT=json
GOMEMLIMIT=1600MiB
