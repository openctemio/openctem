# OpenCTEM platform console, from the openctem-console release archive
# (api/docs/deployment/binary-install.md). Needs Node.js at the major version
# in the archive's NODE_VERSION file, at /usr/bin/node.
#
# /opt/openctem/console -> the unpacked archive; /etc/openctem/console.env holds the
# settings; the Next.js cache (console/.next/cache) is the only writable path, bound
# from /var/cache/openctem/console.
[Unit]
Description=OpenCTEM platform console
Documentation=https://docs.openctem.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openctem-web
Group=openctem-web
EnvironmentFile=/etc/openctem/console.env
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
WorkingDirectory=/opt/openctem/console/app
ExecStart=/usr/bin/node console/server.js
Restart=on-failure
RestartSec=5s
CacheDirectory=openctem/console
CacheDirectoryMode=0750
BindPaths=/var/cache/openctem/console:/opt/openctem/console/app/console/.next/cache
UMask=0027

# Hardening. MemoryDenyWriteExecute stays off: the JavaScript engine compiles
# code at run time.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
