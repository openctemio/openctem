# OpenCTEM gateway (Caddy with the layer4 module), from the openctem-gateway
# release archive (api/docs/deployment/binary-install.md). It runs the same
# entrypoint and Caddyfile as the gateway container: the settings checks, the
# internal CA export, then Caddy.
#
# /opt/openctem/gateway -> the unpacked archive; /etc/openctem/gateway.env
# holds the settings; /var/lib/openctem/gateway is Caddy's storage
# (certificates, the internal CA: 0700).
[Unit]
Description=OpenCTEM gateway
Documentation=https://docs.openctem.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openctem-gateway
Group=openctem-gateway
EnvironmentFile=/etc/openctem/gateway.env
Environment=PATH=/opt/openctem/gateway/bin:/usr/bin:/bin
Environment=OPENCTEM_GATEWAY_DIR=/opt/openctem/gateway/etc
Environment=XDG_DATA_HOME=/var/lib/openctem/gateway/data
Environment=XDG_CONFIG_HOME=/var/lib/openctem/gateway/config
Environment=OPENCTEM_CA_EXPORT_DIR=/var/lib/openctem/gateway/ca-export
ExecStart=/bin/sh /opt/openctem/gateway/etc/entrypoint.sh
ExecReload=/opt/openctem/gateway/bin/caddy reload --config /opt/openctem/gateway/etc/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=openctem/gateway openctem/gateway/data openctem/gateway/config openctem/gateway/ca-export
StateDirectoryMode=0700
LimitNOFILE=1048576
UMask=0027

# Binds 80/443 (and the console port) without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
