      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Panics, login failures, 429s (per 5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "openctem-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "openctem-prometheus"
          },
          "expr": "sum by (where) (increase(openctem_panics_recovered_total[5m]))",
          "legendFormat": "panic {{where}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "openctem-prometheus"
          },
          "expr": "sum by (reason) (increase(openctem_auth_login_failures_total[5m]))",
          "legendFormat": "login {{reason}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "openctem-prometheus"
          },
          "expr": "sum(increase(http_requests_total{job=\"openctem-api\",status=\"429\"}[5m]))",
          "legendFormat": "429"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
