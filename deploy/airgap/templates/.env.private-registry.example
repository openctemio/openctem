# Docker Compose (api/deploy/.env): run OpenCTEM from a private registry.
# Merge these lines into api/deploy/.env. Guide: api/docs/deployment/air-gapped.md.
#
# Replace registry.example.internal/openctem-trusted with the project or
# repository your images were mirrored into (mirror-images.sh writes this
# fragment for you with --env-out). Tags only: Compose pins by tag, so make the
# tags immutable in the registry (Harbor: tag immutability rule; Nexus: disable
# redeploy on the hosted repository).
OPENCTEM_VERSION=@VERSION@
API_IMAGE=registry.example.internal/openctem-trusted/openctem-api
UI_IMAGE=registry.example.internal/openctem-trusted/openctem-web
CONSOLE_IMAGE=registry.example.internal/openctem-trusted/openctem-console
GATEWAY_IMAGE=registry.example.internal/openctem-trusted/openctem-gateway
MIGRATIONS_IMAGE=registry.example.internal/openctem-trusted/migrations

# Third-party images of the bundled datastores, from your registry's copy or
# proxy of Docker Hub (the tags stay POSTGRES_VERSION / REDIS_VERSION).
POSTGRES_IMAGE=registry.example.internal/dockerhub-proxy/library/postgres
REDIS_IMAGE=registry.example.internal/dockerhub-proxy/library/redis

# Optional components.
#SENSOR_IMAGE=registry.example.internal/openctem-trusted/sensor
