# OpenCTEM admin-cli image (bootstrap-admin), assembled from the released
# bootstrap-admin archive. Same entrypoint and user as ghcr.io/openctemio/admin-cli.
ARG BASE_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
FROM ${BASE_IMAGE}
ARG TARGETARCH
COPY dist/${TARGETARCH}/bootstrap-admin/bootstrap-admin /usr/local/bin/bootstrap-admin
LABEL org.opencontainers.image.title="OpenCTEM bootstrap-admin (rebuilt from release @VERSION@)" \
      org.opencontainers.image.version="@VERSION@" \
      org.opencontainers.image.source="https://github.com/openctemio/openctem" \
      org.opencontainers.image.licenses="GPL-3.0-only"
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/bootstrap-admin"]
CMD ["--help"]
