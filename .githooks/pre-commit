#!/bin/sh
# Monorepo pre-commit. Enabled by `make hooks` (git config core.hooksPath .githooks);
# web's `npm ci` also sets it (package.json "prepare"). Runs only the checks for
# the component(s) that have staged files, so an API commit never waits on tsc.
set -e
top=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only --diff-filter=ACMR)

# Private keys, key files and data/ never get committed (same check as CI).
bash "$top/.github/scripts/check-private-keys.sh" --staged || exit 1

# Enterprise overlay files, overlay imports in the Community build and the
# commercial brand name stay out of this repository (same check as CI).
bash "$top/.github/scripts/check-edition-fence.sh" || exit 1

if printf '%s\n' "$staged" | grep -q '^web/'; then
  if [ -d "$top/web/node_modules" ]; then
    (cd "$top/web" && npm run -s type-check && npx --no-install lint-staged)
  else
    echo "pre-commit: web/node_modules missing; skipping web checks (run: make setup)" >&2
  fi
fi

# Message catalogs stay key-sorted (web/scripts/i18n-json.mjs; Node only).
if printf '%s\n' "$staged" | grep -q '^web/src/lib/i18n/dictionaries/.*\.json$'; then
  node "$top/web/scripts/i18n-json.mjs" sort --check || exit 1
fi

gofiles=$(printf '%s\n' "$staged" | grep '^server/.*\.go$' || true)
if [ -n "$gofiles" ]; then
  # Generated files stay as their generator wrote them (some are not gofmt-clean).
  # shellcheck disable=SC2086
  bad=$(cd "$top" && for f in $gofiles; do head -n 20 "$f" | grep -q 'Code generated .* DO NOT EDIT' || gofmt -l "$f"; done)
  if [ -n "$bad" ]; then
    echo "pre-commit: gofmt needed:" >&2; echo "$bad" >&2; exit 1
  fi
fi
exit 0
