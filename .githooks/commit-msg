#!/bin/sh
# Reject AI attribution in commit messages (Generated with Claude Code,
# Co-Authored-By: Claude, Claude-Session, claude.ai/code session links). The
# pattern lives in .github/scripts/check-attribution.sh, shared with the
# "No AI attribution" CI job so both enforce the same rule.
root=$(git rev-parse --show-toplevel) || exit 0
exec bash "$root/.github/scripts/check-attribution.sh" "$1"
