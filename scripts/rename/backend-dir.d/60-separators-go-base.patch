@@ -50,6 +50,12 @@
 fi
 
 merge_base="$(git merge-base "$BASE_REF" HEAD)"
+# Go sources: a base from before the backend directory rename has them in
+# another directory, so every Go line would look added; effective-base.sh then
+# names the pure-move commit to diff against.
+go_base="$merge_base"
+eb="$(git rev-parse --show-toplevel)/.github/scripts/effective-base.sh"
+if [ -f "$eb" ]; then go_base="$(bash "$eb" api "$merge_base" 2>/dev/null || echo "$merge_base")"; fi
 
