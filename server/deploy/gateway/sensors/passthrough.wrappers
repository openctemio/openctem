# OPENCTEM_SENSOR_GATEWAY=passthrough: the ALPN routing of alpn.wrappers, and
# a dedicated sensor host name (SENSOR_PUBLIC_HOSTNAME) routed by its server
# name (SNI), for sensors that do not offer the ALPN id yet. Needs the gateway
# image with the layer4 module (deploy/gateway/Dockerfile).
# docs/rfcs/RFC-059-sensor-transport-v3.md §5.
#
# A TLS connection that offers the ALPN id openctem-sensor/3, or whose SNI is
# SENSOR_PUBLIC_HOSTNAME, is not terminated here: its bytes go to the API's
# mTLS listener, which checks the client certificate itself. A PROXY protocol
# v2 header carries the sensor's address; the API believes it only from
# SENSOR_MTLS_TRUSTED_PROXIES. Every other connection continues to the TLS
# termination below.
listener_wrappers {
	layer4 {
		@sensor_alpn tls alpn openctem-sensor/3
		@sensor_host tls sni {$SENSOR_PUBLIC_HOSTNAME}
		route @sensor_alpn @sensor_host {
			proxy {
				proxy_protocol v2
				upstream {$SENSOR_MTLS_UPSTREAM:api:9443}
			}
		}
	}
	tls
}
