{{- if eq .Auth "pair"}}
{{- $slug := slugify .Sensor.Name -}}
# {{product}} sensor "{{$slug}}": Linux binary as a systemd service
# Generated by {{product}} at {{.GeneratedAt}}. Edit
# configs/sensor-products/sensor/cli.tmpl on the API host to change it.
#
# No key to copy: the sensor makes its own key on first start and pairs.
{{- if .PairingCode}}
# It attaches to pairing code {{.PairingCode}} (single use, valid 10 minutes)
# and prints a fingerprint (journalctl -u openctem-sensor): approve it in the
# console only when the console shows the same fingerprint.
{{- else}}
# It prints a pairing code and a fingerprint (journalctl -u openctem-sensor):
# enter the code under Sensors > Add sensor, compare the fingerprint, approve.
{{- end}}
# The sensor runs the scanners it finds installed on the host (nuclei,
# subfinder, httpx, ...); the container image ships them, this binary does not.

# 1. Download the release and check it against the published checksums.
V={{shellQuote (imageTag .Image)}}
ARCH=$(uname -m | sed -e 's/x86_64/amd64/' -e 's/aarch64/arm64/')
F="openctemio-sensor_${V#v}_linux_${ARCH}.tar.gz"
curl -fsSLO "https://github.com/openctemio/sensor/releases/download/${V}/${F}"
curl -fsSLO "https://github.com/openctemio/sensor/releases/download/${V}/checksums.txt"
sha256sum -c --ignore-missing checksums.txt
tar -xzf "$F" openctemio-sensor
sudo install -m 0755 openctemio-sensor /usr/local/bin/openctemio-sensor

# 2. A system user that owns only the sensor's data directory (its identity
#    key lives in state/identity/, 0600 in 0700).
sudo useradd --system --home-dir /var/lib/openctem --shell /usr/sbin/nologin openctem
sudo install -d -m 0700 -o openctem -g openctem /var/lib/openctem
{{- if .CACert}}

# 3. Trust the platform's certificate authority (it uses a private CA).
sudo mkdir -p /etc/openctem/certs
sudo tee /etc/openctem/certs/openctem-root-ca.crt >/dev/null <<'OPENCTEM_CA'
{{.CACert}}OPENCTEM_CA
sudo chmod 0644 /etc/openctem/certs/openctem-root-ca.crt
{{- end}}

# {{if .CACert}}4{{else}}3{{end}}. Settings (root-only file) and the service, hardened: no new
#    privileges, read-only system, writes only its data directory. No local
#    policy is needed: the sensor follows your organization's scope. To
#    narrow it on this host, write /etc/openctem/sensor-policy.yaml (it can
#    only narrow) and restart the service.
sudo install -d -m 0755 /etc/openctem
sudo tee /etc/openctem/sensor.env >/dev/null <<'OPENCTEM_ENV'
SENSOR_API_URL={{.BaseURL}}
{{- if .PairingCode}}
SENSOR_PAIRING_CODE={{.PairingCode}}
{{- end}}
{{- if .JobSigningRoot}}
SENSOR_JOB_SIGNING_ROOT={{.JobSigningRoot}}
{{- end}}
{{- if .Policy.AllowPrivate}}
SENSOR_ALLOW_PRIVATE_TARGETS=1
{{- end}}
{{- if .CACert}}
SSL_CERT_DIR=/etc/openctem/certs
{{- end}}
{{- if .CAPins}}
SENSOR_CA_SHA256={{.CAPins}}
{{- end}}
OPENCTEM_ENV
sudo chmod 0600 /etc/openctem/sensor.env
sudo tee /etc/systemd/system/openctem-sensor.service >/dev/null <<'OPENCTEM_UNIT'
[Unit]
Description={{product}} sensor
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
User=openctem
Group=openctem
EnvironmentFile=/etc/openctem/sensor.env
Environment=HOME=/var/lib/openctem
ExecStart=/usr/local/bin/openctemio-sensor
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/openctem

[Install]
WantedBy=multi-user.target
OPENCTEM_UNIT
sudo systemctl daemon-reload
sudo systemctl enable --now openctem-sensor

# The sensor prints its pairing code, the link to approve it on and its
# fingerprint; this watch ends by itself once it is paired (Ctrl-C only stops
# watching: the sensor keeps running).
sudo journalctl -u openctem-sensor -f -n 100 -o cat | while IFS= read -r l; do printf '%s\n' "$l"; case "$l" in Paired:*|Enrolled:*) break ;; esac; done || true
{{- else}}
# Sensor binary commands for {{slugify .Sensor.Name}}
# Generated by {{product}} at {{.GeneratedAt}}
# Download: https://github.com/openctemio/sensor/releases ({{imageTag .Image}})

export SENSOR_API_URL={{shellQuote .BaseURL}}
{{- if .APIKey}}
export SENSOR_API_KEY={{shellQuote .APIKey}}
{{- else}}
export SENSOR_API_KEY="${OPENCTEM_API_KEY:?export OPENCTEM_API_KEY first}"
{{- end}}
{{- if .CACert}}
export SSL_CERT_DIR=/etc/openctem/certs
{{- end}}
{{- if .CAPins}}
export SENSOR_CA_SHA256={{.CAPins}}
{{- end}}

# Long-running: run the scans the platform dispatches. The sensor keeps its
# state, including the API key it renews on its own, in SENSOR_STATE_DIR
# (default /var/lib/openctem/state when writable, else ~/.openctem). It runs
# the tools it finds installed; narrow them in the local policy's tools.allow.
# Add -verbose for debug logs.
./openctemio-sensor

# One-shot: scan a directory once and send the results
./openctemio-sensor -tool {{firstTool .Sensor.EffectiveTools}} -target . -push
{{- end}}
